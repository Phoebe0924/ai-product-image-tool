ANALYZE_PROVIDER=openai
IMAGE_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_ANALYZE_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2

# Set to 1 while developing UI to avoid real image API calls.
LIGHTPIC_DEV_MODE=1

# Cloudflare only: forward AI API requests to a fixed-region Vercel deployment.
# Leave empty when running directly on Vercel or locally.
LIGHTPIC_API_ORIGIN=
